{
  "name": "s3-publisher-action",
  "version": "3.0.3",
  "private": true,
  "description": "Publish files to S3 by maintaining file (glob) specific metadata",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint . --max-warnings 0",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --failAfterWarnings",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "keywords": [],
  "author": "Oliver Siegmar",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "async": "^3.2.6",
    "mime-types": "^3.0.2",
    "picomatch": "^4.0.7",
    "s3-etag": "^1.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/async": "^3.2.26",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "rollup": "^4.67.3",
    "ts-jest": "^29.4.15",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "test-exclude": "^8.0.0",
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
